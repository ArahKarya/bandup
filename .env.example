# Postgres connection string
DATABASE_URL="postgresql://bandup:bandup@localhost:5432/bandup"
# Required: 32-byte base64 key that encrypts learners' AI API keys. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Where speaking recordings are stored (if learners choose to keep them)
STORAGE_DIR="./storage"
# Max kept recordings per learner
MAX_STORED_RECORDINGS="100"
# "open" (default) or "closed". When closed, only the first account (the admin) can register.
REGISTRATION="open"
# Number of reverse proxies in front of the app (Caddy, Nginx, Cloudflare Tunnel…), used to read
# the real client IP for rate limiting. Leave 0 when the app is exposed directly.
TRUSTED_PROXY_HOPS="0"
# Calendar day boundaries for streaks and the study plan
APP_TIMEZONE="Asia/Jakarta"
# Allow AI base URLs on localhost/private networks (e.g. a local Ollama). Only for single-user installs.
AI_ALLOW_PRIVATE_BASE_URL="false"
# Optional: link to the source repository on the landing page
NEXT_PUBLIC_REPO_URL=""
